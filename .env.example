# Required
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Server
APP_PORT=8080
# Interface the backend binds to. 0.0.0.0 is correct inside a container that is
# published through Docker/a reverse proxy. If you run the backend directly on a
# host, bind 127.0.0.1 and put a TLS-terminating reverse proxy in front instead.
HOST=0.0.0.0
LOG_LEVEL=INFO

# Expose the interactive API docs (/docs, /redoc) and OpenAPI schema
# (/openapi.json). Disabled by default so the full API surface is not published
# to unauthenticated callers. Set to true only for local development.
EXPOSE_API_DOCS=false

# URL(s) the browser uses to reach the app.
# Must match exactly. Comma-separated for multiple values.
CORS_ORIGINS=http://localhost:8080

# Data paths
DATABASE_URL=sqlite+aiosqlite:////data/licenses.db
STORAGE_PATH=/data/storage
BACKUP_LOCATION=/data/backups
# Docker Compose can restart the backend automatically after a restore. Set this
# to false when running the backend directly in local development.
RESTART_AFTER_RESTORE=true

# Auth
# Initial admin password. Must be changed from defaults before first startup.
# The application refuses to start with blank/common defaults such as admin,
# password, or changeme.
ADMIN_PASSWORD=
TOKEN_EXPIRY=1440
OIDC_STATE_SECRET=
# Unsafe OIDC testing allowances. Leave false for production. Enable only on
# isolated dev/test networks when testing an IdP such as local Keycloak over
# plain HTTP or a private/loopback host.
ALLOW_HTTP_OIDC_DISCOVERY=false
ALLOW_PRIVATE_OIDC_DISCOVERY=false
SESSION_COOKIE_NAME=license_lifecycle_session
# Set to true whenever the app is served over HTTPS (any non-localhost
# deployment) so the session cookie is only ever sent over TLS. Leave false
# only for plain-HTTP local development.
SESSION_COOKIE_SECURE=false

# Email / SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Advanced
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.xlsx,.xls,.csv,.txt,.docx
