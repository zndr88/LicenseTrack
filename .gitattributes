# Auto detect text files and perform LF normalization
* text=auto
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
Dockerfile  text eol=lf
*.md        text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf
