{
  "about": "Typed-number parsing rules shared by backend/app/services/money.py (parse_localized_money) and frontend/src/utils/formatting.js (parseTypedNumberResult). Both test suites run every case. expected is the canonical value, null for blank input; error is 'invalid' or 'ambiguous' when the input is rejected.",
  "cases": [
    {"locale": "en-US", "input": "2,443.00", "expected": "2443.00"},
    {"locale": "en-US", "input": "2443.00", "expected": "2443.00"},
    {"locale": "en-US", "input": "2,443", "expected": "2443"},
    {"locale": "en-US", "input": "1,234,567.8", "expected": "1234567.8"},
    {"locale": "en-US", "input": "1.234", "expected": "1.234"},
    {"locale": "en-US", "input": "0.125", "expected": "0.125"},
    {"locale": "en-US", "input": "-5", "expected": "-5"},
    {"locale": "en-US", "input": " 12 ", "expected": "12"},
    {"locale": "en-US", "input": "$1,234.50", "expected": "1234.50"},
    {"locale": "en-US", "input": "USD 1,234.50", "expected": "1234.50"},
    {"locale": "en-US", "input": "1 234.5", "expected": "1234.5"},
    {"locale": "en-US", "input": "", "expected": null},
    {"locale": "en-US", "input": "   ", "expected": null},
    {"locale": "en-US", "input": "1,5", "error": "invalid"},
    {"locale": "en-US", "input": "12,34.5", "error": "invalid"},
    {"locale": "en-US", "input": "1.2.3", "error": "invalid"},
    {"locale": "en-US", "input": "abc", "error": "invalid"},
    {"locale": "en-US", "input": "12a", "error": "invalid"},
    {"locale": "en-US", "input": "-", "error": "invalid"},
    {"locale": "en-GB", "input": "2,443.00", "expected": "2443.00"},
    {"locale": "en-GB", "input": "£1,234.50", "expected": "1234.50"},

    {"locale": "de-DE", "input": "2,443.00", "error": "invalid"},
    {"locale": "de-DE", "input": "2.443,00", "expected": "2443.00"},
    {"locale": "de-DE", "input": "1.234.567", "expected": "1234567"},
    {"locale": "de-DE", "input": "1.234,5", "expected": "1234.5"},
    {"locale": "de-DE", "input": "1,5", "expected": "1.5"},
    {"locale": "de-DE", "input": "1234,56", "expected": "1234.56"},
    {"locale": "de-DE", "input": "1,234", "expected": "1.234"},
    {"locale": "de-DE", "input": "0,125", "expected": "0.125"},
    {"locale": "de-DE", "input": "1.5", "expected": "1.5"},
    {"locale": "de-DE", "input": "12.25", "expected": "12.25"},
    {"locale": "de-DE", "input": "0.125", "expected": "0.125"},
    {"locale": "de-DE", "input": "1234.567", "expected": "1234.567"},
    {"locale": "de-DE", "input": "1 234,5", "expected": "1234.5"},
    {"locale": "de-DE", "input": "€ 1.234,50", "expected": "1234.50"},
    {"locale": "de-DE", "input": "1.234,50 EUR", "expected": "1234.50"},
    {"locale": "de-DE", "input": "1.234", "error": "ambiguous"},
    {"locale": "de-DE", "input": "12.345", "error": "ambiguous"},
    {"locale": "de-DE", "input": "-1.234", "error": "ambiguous"},
    {"locale": "de-DE", "input": "1.500", "error": "ambiguous"},
    {"locale": "de-DE", "input": "1.234,56,7", "error": "invalid"},
    {"locale": "de-DE", "input": "12.34,5", "error": "invalid"},
    {"locale": "de-DE", "input": "1,2,3", "error": "invalid"},
    {"locale": "nl-BE", "input": "2,443.00", "error": "invalid"},
    {"locale": "nl-BE", "input": "2.443,00", "expected": "2443.00"},
    {"locale": "nl-BE", "input": "1.234", "error": "ambiguous"},
    {"locale": "nl-NL", "input": "0,125", "expected": "0.125"},

    {"locale": "fr-FR", "input": "1 234,50", "expected": "1234.50"},
    {"locale": "fr-FR", "input": "1 234,50", "expected": "1234.50"},
    {"locale": "fr-FR", "input": "1 234,50", "expected": "1234.50"},
    {"locale": "fr-FR", "input": "1234,5", "expected": "1234.5"},
    {"locale": "fr-FR", "input": "1.5", "expected": "1.5"},
    {"locale": "fr-FR", "input": "1.234", "expected": "1.234"},
    {"locale": "fr-FR", "input": "2,443.00", "error": "invalid"},
    {"locale": "fr-FR", "input": "1.234,5", "error": "invalid"},

    {"locale": "de-CH", "input": "1'234.50", "expected": "1234.50"},
    {"locale": "de-CH", "input": "1234.5", "expected": "1234.5"},
    {"locale": "de-CH", "input": "1,5", "error": "invalid"}
  ]
}
